# 1. Copy this file and rename it to application-local.properties
# 2. Fill in your own values matching your docker-compose .env file
# 3. In IntelliJ Run Configuration set: SPRING_PROFILES_ACTIVE=local

spring.datasource.url=jdbc:mysql://localhost:3306/ratings_db
spring.datasource.username=YOUR_MYSQL_USER
spring.datasource.password=YOUR_MYSQL_PASSWORD